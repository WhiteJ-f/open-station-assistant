#!/bin/sh
### BEGIN INIT INFO
# Provides:          station-assistant
# Required-Start:    $network $local_fs
# Required-Stop:
# Default-Start:     S
# Default-Stop:      0 6
# Short-Description: Open Yandex Station Mini Standalone Assistant Daemon
### END INIT INFO

DAEMON_BIN="/bkupgrade/bin/station-assistant"
DAEMON_CFG="/bkupgrade/data/config.json"
SINGBOX_BIN="/bkupgrade/bin/sing-box"
SINGBOX_CFG="/bkupgrade/data/singbox.json"

case "$1" in
    start)
        echo "Starting open station-assistant services..."
        if [ -x "$SINGBOX_BIN" ] && [ -f "$SINGBOX_CFG" ]; then
            /sbin/start-stop-daemon -K -q -x "$SINGBOX_BIN" 2>/dev/null
            /sbin/start-stop-daemon -S -b -q -x "$SINGBOX_BIN" -- run -c "$SINGBOX_CFG"
        fi
        /sbin/start-stop-daemon -K -q -x "$DAEMON_BIN" 2>/dev/null
        /sbin/start-stop-daemon -S -b -q -x "$DAEMON_BIN" -- "$DAEMON_CFG"
        ;;
    stop)
        echo "Stopping open station-assistant services..."
        /sbin/start-stop-daemon -K -q -x "$DAEMON_BIN" 2>/dev/null
        killall station-spotter 2>/dev/null
        killall vl53l0x_ctrl 2>/dev/null
        killall tinycap 2>/dev/null
        killall tinyplay 2>/dev/null
        if [ -x "$SINGBOX_BIN" ]; then
            /sbin/start-stop-daemon -K -q -x "$SINGBOX_BIN" 2>/dev/null
        fi
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        if pidof station-assistant >/dev/null; then
            echo "station-assistant is running (PID $(pidof station-assistant))"
        else
            echo "station-assistant is NOT running"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
