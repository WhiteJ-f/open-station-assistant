#!/bin/sh
# /etc/init.d/S99station-assistant
# Autostart open station assistant on boot for Yandex Station Mini 1

case "$1" in
    start)
        echo "Starting open station-assistant services..."
        if [ -x /bkupgrade/bin/sing-box ] && [ -f /bkupgrade/data/singbox.json ]; then
            killall sing-box 2>/dev/null
            nohup /bkupgrade/bin/sing-box run -c /bkupgrade/data/singbox.json >/tmp/singbox.log 2>&1 &
        fi
        killall station-assistant 2>/dev/null
        nohup /bkupgrade/bin/station-assistant /bkupgrade/data/config.json >/tmp/assistant.log 2>&1 &
        ;;
    stop)
        echo "Stopping open station-assistant services..."
        killall station-assistant 2>/dev/null
        killall station-spotter 2>/dev/null
        killall vl53l0x_ctrl 2>/dev/null
        killall tinycap 2>/dev/null
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
exit 0
